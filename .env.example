# --- Google Drive (production) ---
# Service account key JSON (paste the whole JSON on one line, or base64-encode it).
GOOGLE_SERVICE_ACCOUNT_KEY=
# ID of the "Topaz Asset Library" folder (from its URL: drive.google.com/drive/folders/<ID>).
# If omitted, the folder is looked up by name.
GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_FOLDER_NAME=Topaz Asset Library

# Secret for /api/revalidate?secret=... (forces an immediate refresh from Drive).
REVALIDATE_SECRET=

# --- Local development only ---
# Read the library from a folder on disk when GOOGLE_SERVICE_ACCOUNT_KEY is not set.
# LOCAL_LIBRARY_PATH=/path/to/Topaz Asset Library
